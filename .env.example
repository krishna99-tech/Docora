# Application Environment
APP_ENV=development
APP_PORT=8080

# URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# PostgreSQL Database
POSTGRES_USER=docora_user
POSTGRES_PASSWORD=docora_secure_password_123
POSTGRES_DB=docora_db
DATABASE_URL=postgres://docora_user:docora_secure_password_123@postgres:5432/docora_db?sslmode=disable
# For running backend directly on host machine (outside docker):
# DATABASE_URL=postgres://docora_user:docora_secure_password_123@localhost:5432/docora_db?sslmode=disable

# Authentication Secrets & Tokens
JWT_SECRET=super_secret_jwt_key_docora_receipt_platform_min_32_chars!
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h

# File Storage Configuration
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_PATH=/app/storage
# For local host machine:
# DOCUMENT_STORAGE_PATH=./storage

# PDF Generation Engine (chromedp headless chromium)
PDF_RENDERER=chromedp
CHROME_BIN=

# Nginx & Network Ports
NGINX_PORT=80
BACKEND_PORT=8080
FRONTEND_PORT=3000
